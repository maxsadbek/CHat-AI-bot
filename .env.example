[TEMPLATE]
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.vercel.app/api/webhook

# 🔐 Webhook secret token (REQUIRED — security critical!)
# Telegram sends this with every webhook request. Without this, ANYONE can send fake updates.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=your_32_char_hex_secret_here

# OpenAI Compatible API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Retention Reminder (cron job — scripts/retention-reminder.ts)
# Users inactive for RETENTION_INACTIVE_DAYS days get a "we miss you" reminder.
# A user is only reminded again after RETENTION_REMINDER_INTERVAL_DAYS days.
# Set RETENTION_DRY_RUN=true to log only without sending messages.
RETENTION_INACTIVE_DAYS=3
RETENTION_REMINDER_INTERVAL_DAYS=7
# RETENTION_DRY_RUN=false

# Database
DATABASE_URL=postgresql://user:password@host:5432/ai_creator_studio

# Admin
ADMIN_IDS=123456789,987654321

# 🔐 Admin login password — MUST be at least 24 random characters
# This is used ONLY as the login password for the admin panel at /admin/login.
# After logging in, a secure httpOnly session cookie (admin_session) is set.
# The cookie is HMAC-signed and expires after 12 hours.
# The old Bearer token approach has been replaced — ADMIN_SECRET is now
# consumed solely as a login password, never sent over the wire except
# once during the POST /api/admin/login request (over HTTPS).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your_random_admin_secret_min_24_chars

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=AI Creator Studio

# ─── Serverless Rate Limiting (RECOMMENDED) ───────────────
# Upstash Redis for cross-instance rate limiting on Vercel.
# Get free tier: https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://your-region-1234.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
