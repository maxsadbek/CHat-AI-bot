[TEMPLATE]
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.vercel.app/api/webhook

# 🔐 Webhook secret token (REQUIRED — security critical!)
# Telegram sends this with every webhook request. Without this, ANYONE can send fake updates.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=your_32_char_hex_secret_here

# OpenAI Compatible API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql://user:password@host:5432/ai_creator_studio

# Admin
ADMIN_IDS=123456789,987654321

# 🔐 Admin API secret — MUST be at least 24 random characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your_random_admin_secret_min_24_chars

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=AI Creator Studio

# ─── Serverless Rate Limiting (RECOMMENDED) ───────────────
# Upstash Redis for cross-instance rate limiting on Vercel.
# Get free tier: https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://your-region-1234.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
