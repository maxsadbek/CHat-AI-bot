generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ─────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  telegramId    BigInt    @unique
  firstName     String
  lastName      String?
  username      String?
  languageCode  String?
  isPremium     Boolean   @default(false)
  requestsToday Int       @default(0)
  totalRequests Int       @default(0)
  dailyLimit    Int       @default(50)
  lastResetAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime  @default(now())

  conversations Conversation[]
  messages      Message[]
  usage         Usage[]
  subscription  Subscription?
  settings      UserSettings?
  projects      Project[]
  projectFiles  ProjectFile[]
  projectNotes  ProjectNote[]
  payments      Payment[]
  manualPayments ManualPayment[]

  @@index([telegramId])
  @@index([createdAt])
  @@map("users")
}

// ─── Conversation ─────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  userId    Int
  projectId String?                                 // Optional — scopes conversation to a project
  title     String   @default("New Conversation")
  feature   String   @default("chat")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([projectId])
  @@index([feature])
  @@index([createdAt])
  @@map("conversations")
}

// ─── Message ──────────────────────────────────────────

model Message {
  id             String   @id @default(uuid())
  conversationId String
  userId         Int
  role           String   // "user" | "assistant" | "system"
  content        String
  tokensUsed     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

// ─── Usage ────────────────────────────────────────────

model Usage {
  id        String   @id @default(uuid())
  userId    Int
  feature   String   // "chat" | "video" | "image" | "social" | "business" | "coding" | "translate"
  provider  String?  // "openai" | "gemini" | "claude" | "deepseek"
  model     String?  // "gpt-4o" | "gemini-2.0-flash" | etc.
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@index([provider])
  @@index([createdAt])
  @@map("usage")
}

// ─── Subscription ─────────────────────────────────────

model Subscription {
  id              String    @id @default(uuid())
  userId          Int       @unique
  tier            String    @default("free")           // "free" | "pro"
  planType        String    @default("free")           // "free" | "pro_monthly" | "pro_yearly" | "lifetime"
  billingPeriod   String    @default("none")           // "none" | "monthly" | "yearly" | "lifetime"
  status          String    @default("ACTIVE")         // "ACTIVE" | "EXPIRED" | "CANCELED"
  dailyLimit      Int       @default(50)
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  canceledAt      DateTime?                            // When the subscription was canceled
  paymentId       String?
  paymentProvider String?                              // "telegram_stars" | "stripe" | "click" | "payme" | etc.
  autoRenew       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planType])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ─── Payment ──────────────────────────────────────────

model Payment {
  id            String    @id @default(uuid())
  userId        Int
  provider      String                                // "click" | "payme" | "stripe" | "telegram_stars"
  plan          String                                // "free" | "pro_monthly" | "pro_yearly" | "lifetime"
  amount        Int                                   // Amount in minor units (cents / tiyin / stars)
  currency      String    @default("USD")             // ISO 4217 — "USD", "UZS", "XTR" (Telegram Stars)
  transactionId String?                               // Provider transaction ID
  status        String    @default("PENDING")         // "PENDING" | "SUCCESS" | "FAILED" | "CANCELED"
  metadata      Json?                                 // Provider-specific raw response data
  createdAt     DateTime  @default(now())
  paidAt        DateTime?                             // When payment was confirmed
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([transactionId])
  @@index([createdAt])
  @@map("payments")
}

// ─── User Settings ────────────────────────────────────

model UserSettings {
  id                   String  @id @default(uuid())
  userId               Int     @unique
  language             String  @default("en")
  theme                String  @default("dark")
  notificationsEnabled Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─── Project ───────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  userId      Int
  name        String
  description String?
  emoji       String   @default("📁")
  color       String?                              // Visual accent color (hex)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  files         ProjectFile[]
  notes         ProjectNote[]

  @@index([userId])
  @@index([userId, isArchived])
  @@index([updatedAt])
  @@map("projects")
}

// ─── Project File ─────────────────────────────────────

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  userId    Int
  fileName  String
  fileType  String                                 // "image" | "video" | "document" | "code" | "note" | "other"
  fileUrl   String?                                // External URL or file path
  content   String?                                // Text content (for code snippets, notes)
  size      Int?                                   // File size in bytes
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fileType])
  @@map("project_files")
}

// ─── Project Note ─────────────────────────────────────

model ProjectNote {
  id        String   @id @default(uuid())
  projectId String
  userId    Int
  title     String   @default("Untitled Note")
  content   String   @default("")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([isPinned])
  @@map("project_notes")
}

// ─── Admin Log ─────────────────────────────────────────

// ─── Manual Payment (Temporary) ──────────────────────

model ManualPayment {
  id               String    @id @default(uuid())
  userId           Int
  telegramUserId   BigInt                                  // Telegram user ID who submitted the payment
  plan             String                                  // Plan ID e.g. "pro_monthly" | "pro_yearly" | "lifetime"
  amount           Int       @default(0)                   // Amount in minor units (UZS tiyin)
  currency         String    @default("UZS")
  status           String    @default("PENDING")           // "PENDING" | "APPROVED" | "REJECTED"
  receiptFileId    String                                  // Telegram file_id of the payment receipt screenshot
  receiptMessageId Int?                                    // Telegram message_id of the receipt photo message
  adminId          BigInt?                                 // Admin Telegram ID who processed the approval/rejection
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("manual_payments")
}

model AdminLog {
  id        String   @id @default(uuid())
  action    String
  adminId   BigInt
  details   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@map("admin_logs")
}
